==============================================
CONFIGURATION ENVIRONNEMENT DE PRODUCTION
==============================================
NODE_ENV=production
APP_NAME=HealthCenterSoft-BackOffice
APP_VERSION=1.0.0

==============================================
CONFIGURATION SERVEUR WEB
==============================================
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
SESSION_TIMEOUT=3600000

==============================================
BASE DE DONNÉES SQL SERVER
==============================================
DB_SERVER=DESKTOP-G2TN8LC      #212.47.73.151 /DESKTOP-G2TN8LC 
DB_DATABASE=hcs_backoffice
DB_USER=hcs_dbadmin
DB_PASSWORD=healthsoft@25
DB_NAME=hcs_backoffice
DB_PORT=1433

Configuration avancée SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=15000
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_CREATE_RETRY_INTERVAL=100

==============================================
SÉCURITÉ - AUTHENTIFICATION & AUTORISATION
==============================================
JWT Configuration
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..turVolvE6TzpjDOqrIYoFnEpbsTNVTU-MTnpA8Wcogk
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=votre_refresh_secret_ici_32_caracteres_minimum
JWT_REFRESH_EXPIRES_IN=7d

Hashage des mots de passe
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=72

==============================================
CORS & SÉCURITÉ DES REQUÊTES
==============================================
Origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://172.20.10.3:3000,http://172.20.10.3:5000,http://localhost:5000
FRONTEND_URL=https://votredomaine.com
CORS_MAX_AGE=86400
CORS_CREDENTIALS=true

Limites de requêtes
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESSFUL=false
REQUEST_SIZE_LIMIT=10mb
MAX_PARAM_LENGTH=1000

==============================================
UPLOAD & STOCKAGE DE FICHIERS
==============================================
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=5242880 # 5MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
MAX_FILES_PER_REQUEST=10
CLEANUP_TEMP_FILES=true
TEMP_FILE_LIFETIME=3600000 # 1 heure

==============================================
JOURNALISATION & MONITORING
==============================================
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIRECTORY=logs
LOG_MAX_SIZE=10485760 # 10MB
LOG_MAX_FILES=30
LOG_COMPRESS=true
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=true
ENABLE_PERFORMANCE_MONITORING=true
METRICS_ENABLED=true

==============================================
SÉCURITÉ AVANCÉE
==============================================
HELMET_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

Content Security Policy
CSP_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; form-action 'self'

Protection XSS
XSS_PROTECTION_ENABLED=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
REFERRER_POLICY=strict-origin-when-cross-origin

Sécurité des cookies (si utilisés)
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=strict
COOKIE_PREFIX=__Secure-

==============================================
SAUVEGARDE & MAINTENANCE
==============================================
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_DIRECTORY=backups
BACKUP_COMPRESSION=true
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_TOKENS=votre_token_secret_ici

==============================================
PERFORMANCE & MISE À L'ÉCHELLE
==============================================
CLUSTER_MODE=false
WORKER_COUNT=auto
COMPRESSION_ENABLED=true
CACHE_CONTROL_MAX_AGE=86400
ETAG_ENABLED=true

==============================================
EMAIL & NOTIFICATIONS
==============================================
SMTP_HOST=smtp.votre-fournisseur.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@votredomaine.com
SMTP_PASSWORD=votre-mot-de-passe
EMAIL_FROM=noreply@votredomaine.com
EMAIL_SUPPORT=support@votredomaine.com

==============================================
CONFIGURATIONS SPÉCIFIQUES MÉTIER
==============================================
MAX_PATIENTS_PER_DOCTOR=50
APPOINTMENT_DURATION=30 # minutes
WORKING_HOURS_START=08:00
WORKING_HOURS_END=18:00
EMERGENCY_CONTACT_NUMBER=+33123456789

==============================================
VARIABLES DE DÉBOGAGE (DÉSACTIVÉES EN PRODUCTION)
==============================================
DEBUG=false
QUERY_LOGGING=false
SHOW_ERROR_DETAILS=false
ENABLE_DEV_ROUTES=false

==============================================
VARIABLES DE SANTÉ DE L'APPLICATION
==============================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/alive

==============================================
CONFIGURATION DU TEMPS
==============================================
TIMEZONE=Africa/Douala
DATE_FORMAT=YYYY-MM-DD
DATETIME_FORMAT=YYYY-MM-DD HH:mm:ss
BUSINESS_DAYS=1,2,3,4,5 # Lundi à Vendredi

==============================================
SÉCURITÉ SUPPLÉMENTAIRE
==============================================
REQUIRE_2FA=false
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900000 # 15 minutes
SESSION_CLEANUP_INTERVAL=3600000 # 1 heure
PASSWORD_HISTORY_SIZE=5
FORCE_PASSWORD_ROTATION_DAYS=90

==============================================
CONFIGURATION AUDIT
==============================================
AUDIT_LOG_ENABLED=true
AUDIT_RETENTION_DAYS=365
LOG_SENSITIVE_ACTIONS=true
LOG_DATA_ACCESS=true

==============================================
DÉPENDANCES EXTERNES
==============================================
EXTERNAL_API_TIMEOUT=10000
EXTERNAL_API_RETRY_ATTEMPTS=3
EXTERNAL_API_RETRY_DELAY=1000

==============================================
ENCRYPTION DES DONNÉES SENSIBLES
==============================================
DATA_ENCRYPTION_KEY=votre_clé_encryption_32_caractères
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPT_PII=true
ENCRYPTED_FIELDS=email,phone,address

==============================================
CONFIGURATION DES QUEUES (OPTIONNEL)
==============================================
QUEUE_ENABLED=false
QUEUE_CONNECTION=redis://localhost:6379
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000

==============================================
VARIABLES SPÉCIFIQUES À L'HÉBERGEMENT
==============================================
DOCKER_MODE=false
KUBERNETES_MODE=false
CLOUD_PROVIDER=none
REGION=europe-west1
INSTANCE_ID=production-instance-001